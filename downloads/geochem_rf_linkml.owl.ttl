geochem_rf_linkml:AttrTypeEnum a owl:Class ;
    rdfs:label "AttrTypeEnum" ;
    owl:unionOf ( <https://w3id.org/sierra-moxon/geochem-rf-linkml/AttrTypeEnum#method_id> <https://w3id.org/sierra-moxon/geochem-rf-linkml/AttrTypeEnum#flag_id> <https://w3id.org/sierra-moxon/geochem-rf-linkml/AttrTypeEnum#treatment_id> <https://w3id.org/sierra-moxon/geochem-rf-linkml/AttrTypeEnum#sensor_id> ) ;
