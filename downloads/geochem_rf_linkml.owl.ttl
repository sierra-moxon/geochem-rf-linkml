    skos:definition "Timing detail of the method." ;
    skos:inScheme <https://w3id.org/sierra-moxon/geochem-rf-linkml> .

geochem_rf_linkml:missing_value_code a owl:DatatypeProperty ;
    rdfs:label "missing_value_code" ;
    skos:definition "Code used in the data file to indicate a missing value." ;
    skos:inScheme <https://w3id.org/sierra-moxon/geochem-rf-linkml> .

geochem_rf_linkml:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    skos:definition "A human-readable name for a thing." ;
    skos:inScheme <https://w3id.org/sierra-moxon/geochem-rf-linkml> .

geochem_rf_linkml:numeric_value a owl:DatatypeProperty ;
    rdfs:label "numeric_value" ;
    rdfs:range xsd:float ;
    skos:definition "The numeric measure (kept typed for Parquet stats / pushdown)." ;
    skos:inScheme <https://w3id.org/sierra-moxon/geochem-rf-linkml> .

geochem_rf_linkml:raw_value a owl:DatatypeProperty ;
    rdfs:label "raw_value" ;
    rdfs:range xsd:string ;
    skos:definition "The unnormalized atomic string as reported (e.g. \"2.2 mg/L\")." ;
    skos:inScheme <https://w3id.org/sierra-moxon/geochem-rf-linkml> .

geochem_rf_linkml:sample a owl:ObjectProperty ;
    rdfs:label "sample" ;
    rdfs:range geochem_rf_linkml:Sample ;
    skos:definition "Foreign key to the sample dimension." ;
    skos:inScheme <https://w3id.org/sierra-moxon/geochem-rf-linkml> .

geochem_rf_linkml:sample_name a owl:DatatypeProperty ;
    rdfs:label "sample_name" ;
    skos:definition "Name/identifier of the physical sample." ;
    skos:inScheme <https://w3id.org/sierra-moxon/geochem-rf-linkml> .

geochem_rf_linkml:string_value a owl:DatatypeProperty ;
    rdfs:label "string_value" ;
    rdfs:range xsd:string ;
    skos:definition "The measure when it is textual (typed EAV column, sparse)." ;
    skos:inScheme <https://w3id.org/sierra-moxon/geochem-rf-linkml> .

geochem_rf_linkml:time_elapsed a owl:DatatypeProperty ;
    rdfs:label "time_elapsed" ;
    rdfs:range xsd:float ;
    skos:definition "Elapsed time for a time-series measurement." ;
    skos:inScheme <https://w3id.org/sierra-moxon/geochem-rf-linkml> .

geochem_rf_linkml:treatment_id a owl:DatatypeProperty ;
    rdfs:label "treatment_id" ;
    skos:definition "Treatment identifier applied to this measurement." ;
    skos:inScheme <https://w3id.org/sierra-moxon/geochem-rf-linkml> .

geochem_rf_linkml:unit_cv_id a owl:DatatypeProperty ;
    rdfs:label "unit_cv_id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "The unit expressed as an ontology CURIE (e.g. UO / UCUM)." ;
    skos:inScheme <https://w3id.org/sierra-moxon/geochem-rf-linkml> .

geochem_rf_linkml:variable a owl:ObjectProperty ;
    rdfs:label "variable" ;
    rdfs:range geochem_rf_linkml:MeasurementVariable ;
    skos:definition "Foreign key to the variable dimension." ;
    skos:inScheme <https://w3id.org/sierra-moxon/geochem-rf-linkml> .

geochem_rf_linkml:MeasurementVariable a owl:Class ;
    rdfs:label "MeasurementVariable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty geochem_rf_linkml:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty geochem_rf_linkml:unit_cv_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geochem_rf_linkml:upper_bound ],
        [ a owl:Restriction ;
            owl:allValuesFrom geochem_rf_linkml:StatisticEnum ;
            owl:onProperty geochem_rf_linkml:statistic_spatial ],
        [ a owl:Restriction ;
            owl:allValuesFrom geochem_rf_linkml:DataTypeEnum ;
            owl:onProperty geochem_rf_linkml:data_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:upper_bound ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geochem_rf_linkml:data_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:column_or_row_long_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty geochem_rf_linkml:column_or_row_long_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty geochem_rf_linkml:column_or_row_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty geochem_rf_linkml:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:definition ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty geochem_rf_linkml:definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom geochem_rf_linkml:StatisticEnum ;
            owl:onProperty geochem_rf_linkml:statistic_measurement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty geochem_rf_linkml:definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty geochem_rf_linkml:upper_bound ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:unit_basis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:lower_bound ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geochem_rf_linkml:statistic_temporal ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:statistic_measurement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geochem_rf_linkml:representation_temporal ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geochem_rf_linkml:column_or_row_long_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geochem_rf_linkml:statistic_spatial ],
        [ a owl:Restriction ;
            owl:allValuesFrom geochem_rf_linkml:RepresentationTemporalEnum ;
            owl:onProperty geochem_rf_linkml:representation_temporal ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geochem_rf_linkml:statistic_measurement ],
        [ a owl:Restriction ;
            owl:allValuesFrom geochem_rf_linkml:StatisticEnum ;
            owl:onProperty geochem_rf_linkml:statistic_temporal ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:representation_temporal ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty geochem_rf_linkml:missing_value_code ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geochem_rf_linkml:unit_cv_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty geochem_rf_linkml:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom geochem_rf_linkml:UnitEnum ;
            owl:onProperty geochem_rf_linkml:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:column_or_row_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geochem_rf_linkml:column_or_row_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:missing_value_code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:statistic_spatial ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:unit_cv_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty geochem_rf_linkml:lower_bound ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:statistic_temporal ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geochem_rf_linkml:missing_value_code ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geochem_rf_linkml:lower_bound ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:data_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty geochem_rf_linkml:unit_basis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geochem_rf_linkml:unit_basis ],
        geochem_rf_linkml:Attribute ;
    owl:hasKey ( geochem_rf_linkml:label geochem_rf_linkml:unit geochem_rf_linkml:unit_basis geochem_rf_linkml:statistic_measurement geochem_rf_linkml:statistic_spatial geochem_rf_linkml:statistic_temporal geochem_rf_linkml:representation_temporal ) ;
    skos:definition "A fully-qualified measured variable: the bare `Attribute` concept plus its unit and statistical/temporal qualifiers. One row of the ESS-DIVE Data Dictionary. This is the \"variable dimension\" of the star schema; the dimension business key is the qualified-identity tuple (see `unique_keys`), NOT the arbitrary user column name." ;
    skos:inScheme <https://w3id.org/sierra-moxon/geochem-rf-linkml> .

