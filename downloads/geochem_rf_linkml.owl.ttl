geochem_rf_linkml:Sample a owl:Class ;
    rdfs:label "Sample" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geochem_rf_linkml:latitude ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty geochem_rf_linkml:sample_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:location_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geochem_rf_linkml:datetime_collected ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty geochem_rf_linkml:latitude ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:longitude ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:sample_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geochem_rf_linkml:longitude ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty geochem_rf_linkml:longitude ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty geochem_rf_linkml:location_description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:datetime_collected ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geochem_rf_linkml:latitude ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty geochem_rf_linkml:datetime_collected ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geochem_rf_linkml:location_description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty geochem_rf_linkml:sample_name ] ;
    skos:definition "A physical sample (or a time point on a sample) that measurements are made on. The sample dimension of the star schema." ;
    skos:inScheme <https://w3id.org/sierra-moxon/geochem-rf-linkml> .

geochem_rf_linkml:attr_id a owl:DatatypeProperty ;
    rdfs:label "attr_id" ;
    skos:definition "Identifier for a method/flag/treatment/sensor (Methods & Attributes `attr_id`)." ;
    skos:inScheme <https://w3id.org/sierra-moxon/geochem-rf-linkml> .

geochem_rf_linkml:attr_type a owl:ObjectProperty ;
